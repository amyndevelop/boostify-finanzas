DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/boostify?sslmode=require"
ADMIN_EMAIL="admin@example.com"
# Generate with npm run admin:hash (interactive, no password in shell history).
ADMIN_PASSWORD_HASH=""
# Generate locally with: openssl rand -base64 48
SESSION_SECRET=""

# Optional Belo email integration. Disabled until explicitly configured.
BELO_IMPORT_ENABLED="false"
BELO_IMPORT_CURRENCY="ARS"
# ISO UTC date/time chosen at activation; use the same value in Apps Script.
BELO_IMPORT_START_AT=""
# Separate from SESSION_SECRET. Generate: openssl rand -base64 48
BELO_WEBHOOK_SECRET=""
